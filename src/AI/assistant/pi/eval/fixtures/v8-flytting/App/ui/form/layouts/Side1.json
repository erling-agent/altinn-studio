{
  "$schema": "https://altinncdn.no/toolkits/altinn-app-frontend/4/schemas/json/layout/layout.schema.v1.json",
  "data": {
    "hidden": false,
    "layout": [
      {
        "id": "personopplysninger-heading",
        "type": "Header",
        "size": "L",
        "textResourceBindings": {
          "title": "Side1.heading.title"
        }
      },
      {
        "id": "fornavn",
        "type": "Input",
        "textResourceBindings": {
          "title": "Side1.fornavn.title"
        },
        "dataModelBindings": {
          "simpleBinding": "fornavn"
        },
        "autocomplete": "given-name",
        "required": true
      },
      {
        "id": "etternavn",
        "type": "Input",
        "textResourceBindings": {
          "title": "Side1.etternavn.title"
        },
        "dataModelBindings": {
          "simpleBinding": "etternavn"
        },
        "autocomplete": "family-name",
        "required": true
      },
      {
        "id": "fodselsnummer",
        "type": "Input",
        "textResourceBindings": {
          "title": "Side1.fodselsnummer.title"
        },
        "dataModelBindings": {
          "simpleBinding": "fodselsnummer"
        },
        "required": true
      },
      {
        "id": "epost",
        "type": "Input",
        "textResourceBindings": {
          "title": "Side1.epost.title"
        },
        "dataModelBindings": {
          "simpleBinding": "epost"
        },
        "autocomplete": "email",
        "required": true
      },
      {
        "id": "telefonnummer",
        "type": "Input",
        "textResourceBindings": {
          "title": "Side1.telefonnummer.title"
        },
        "dataModelBindings": {
          "simpleBinding": "telefonnummer"
        },
        "autocomplete": "tel",
        "labelSettings": {
          "optionalIndicator": true
        }
      },
      {
        "id": "personopplysninger-navigation",
        "type": "NavigationButtons"
      }
    ]
  }
}
